[Unit]
Description=K1 desktop rollouts agent
After=network-online.target

[Service]
WorkingDirectory=/home/vivi/c/k1-motion
ExecStart=/usr/bin/python3 /home/vivi/c/k1-motion/infrastructure/dashboard/agent.py --config /home/vivi/c/k1-motion/infrastructure/dashboard/desktop.json --mode rollouts
Restart=on-failure
RestartSec=5
Nice=10
[Install]
WantedBy=default.target
