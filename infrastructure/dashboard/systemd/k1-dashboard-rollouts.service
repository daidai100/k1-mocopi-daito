[Unit]
Description=K1 server CPU rollout worker
After=k1-dashboard.service

[Service]
Environment=PYTHONPATH=/mnt/ssd1/k1-motion/benchmarks/sim-backend-comparison-20260921/py311-deps
ExecStart=/mnt/ssd1/k1-dashboard/.venv/bin/python /mnt/ssd1/k1-dashboard/app/agent.py --config /mnt/ssd1/k1-dashboard/app/server.json --mode rollouts
Nice=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
